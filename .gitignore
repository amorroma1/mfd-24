# --- Build output -----------------------------------------------------------------------------
.gradle/
build/
*.apk
*.aab

# --- Local machine ----------------------------------------------------------------------------
# local.properties carries the SDK path, which is per-machine by definition.
local.properties
.idea/
*.iml
.vs/
.kotlin/
.DS_Store
captures/

# --- Generated, and cheap to regenerate -------------------------------------------------------
# Overpass snapshots: an intermediate cache for tools/poi/build_poi.py. The CSVs it produces are
# committed, so the build never needs these, and a megabyte of raw JSON is not worth versioning.
# Refetch with tools/poi/fetch_osm.py.
tools/poi/raw/

# The time-zone boundary release tools/tz/build_tz.py --fetch downloads: 56 MB zipped, 185 MB
# unpacked. The grid cut from it is committed; the source is pinned by release and SHA-256.
tools/tz/raw/

# Default output of tools/poi/preview_glyphs.py, which is a thing you look at, not a thing you keep.
tools/poi/glyph_preview.png

# Working notes stay local; the public repository carries the README and docs/ only.
CLAUDE.md
__pycache__/
